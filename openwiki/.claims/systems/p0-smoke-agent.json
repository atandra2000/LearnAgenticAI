          "version": "repo-lines-v1:sha256:7aff76f771cd0f43d873b031be670089bea17f101b234e1d5e753aeaa43ddfc5:"
        }
      ]
    },
    {
      "id": "claim_172611e9d79b44ec9b4d8fb51b6a5c6d",
      "statement": "The P0 agent uses the shared `reasoning` model route and prepends a fixed friendly-echo system prompt before all converted request messages; it streams the model with `astream()` and emits token events only for chunks with nonempty content.",
