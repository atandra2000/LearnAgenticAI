    {
      "id": "claim_ed06718461f14ab58fb143d2484203f8",
      "statement": "The UI accumulates P0 token content in the active assistant message, attaches `trace_meta`, and renders in-stream `error` events inline; it can abort the browser request but P0 contains no explicit server-side disconnect or cancellation policy.",
